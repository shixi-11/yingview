<Application x:Class="YingView.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <Application.Resources>
    <SolidColorBrush x:Key="ShellBrush" Color="#111417"/>
    <SolidColorBrush x:Key="BarBrush" Color="#191D21"/>
    <SolidColorBrush x:Key="TextBrush" Color="#EDF0F2"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#A9B1B8"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#91D9C5"/>
    <SolidColorBrush x:Key="LineBrush" Color="#333A41"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#293138"/>
    <SolidColorBrush x:Key="PressedBrush" Color="#354139"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#14231F"/>
    <sys:Double x:Key="ControlTextSize">13</sys:Double>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="1,0"/>
      <Setter Property="FontSize" Value="{DynamicResource ControlTextSize}"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bg" Property="Background" Value="{DynamicResource PressedBrush}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Bg" Property="BorderThickness" Value="1"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bg" Property="Opacity" Value="0.36"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Menu"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="FontSize" Value="{DynamicResource ControlTextSize}"/></Style>
    <Style TargetType="MenuItem"><Setter Property="Padding" Value="10,7"/><Setter Property="Foreground" Value="#20242A"/><Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/><Setter Property="FontSize" Value="{DynamicResource ControlTextSize}"/></Style>
    <Style TargetType="ToolTip"><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="9,6"/><Setter Property="Background" Value="#F7F7F5"/><Setter Property="Foreground" Value="#20242A"/></Style>
  </Application.Resources>
</Application>
