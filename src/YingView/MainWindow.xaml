<Window x:Class="YingView.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:YingView"
    Title="YingView" Icon="Assets/yingview.ico" Width="1280" Height="820" MinWidth="720" MinHeight="520" WindowState="Maximized" Background="{DynamicResource ShellBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI, Microsoft YaHei UI" AllowDrop="True" UseLayoutRounding="True">
  <Grid x:Name="Root">
    <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="62"/><RowDefinition Height="28"/></Grid.RowDefinitions>
    <Border x:Name="Toolbar" Background="{DynamicResource BarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
      <Grid Margin="12,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="OpenButton" Click="OpenClick" Background="{DynamicResource HoverBrush}" Padding="11,7" ToolTip="Open image or folder">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8E5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"/><TextBlock Text="  Open" Margin="2,0,0,0"/></StackPanel>
          </Button>
          <Border Width="1" Height="20" Background="{DynamicResource LineBrush}" Margin="9,0"/>
          <Button x:Name="PreviousButton" Click="PreviousClick" Content="&#xE76B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Padding="9,7" ToolTip="Previous image"/>
          <Button x:Name="NextButton" Click="NextClick" Content="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Padding="9,7" ToolTip="Next image"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Button x:Name="FitButton" Click="FitClick" Content="Fit" Padding="11,7" ToolTip="Fit image to view"/>
          <Button x:Name="ActualButton" Content="100%" Click="ActualClick" Padding="10,7" ToolTip="Actual pixels"/>
          <Border Width="1" Height="20" Background="{DynamicResource LineBrush}" Margin="8,0"/>
          <Button x:Name="ZoomOutButton" Content="&#xE738;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Click="ZoomOutClick" Padding="8,7" ToolTip="Zoom out"/>
          <TextBlock x:Name="ZoomLabel" Text="—" VerticalAlignment="Center" TextAlignment="Center" Width="52" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
          <Button x:Name="ZoomInButton" Content="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Click="ZoomInClick" Padding="8,7" ToolTip="Zoom in"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="RotateButton" Content="&#xE7AD;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Padding="9,7" Click="RotateClick" ToolTip="Rotate clockwise"/>
          <Button x:Name="FullscreenButton" Content="&#xE740;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Padding="9,7" Click="FullscreenClick" ToolTip="Fullscreen"/>
          <Menu VerticalAlignment="Center"><MenuItem x:Name="MoreMenu" Header="•••" Foreground="{DynamicResource TextBrush}" FontSize="15"/></Menu>
        </StackPanel>
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
          <Button x:Name="StudioButton" Click="StyleStudioClick" Content="&#xE790;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Padding="9,7" ToolTip="Style studio"/>
          <Button x:Name="DeleteButton" Click="DeleteClick" Content="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Padding="9,7" ToolTip="Delete image"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1" x:Name="Stage" Background="{DynamicResource ShellBrush}">
      <local:ImageSurface x:Name="Surface"/>
      <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="28">
        <TextBlock Text="&#xE8B9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="36" HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,18"/>
        <TextBlock x:Name="EmptyTitle" FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        <TextBlock x:Name="EmptySubtitle" MaxWidth="500" TextWrapping="Wrap" TextAlignment="Center" FontSize="14" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,8,0,20"/>
        <Button x:Name="EmptyOpenButton" Click="OpenClick" HorizontalAlignment="Center" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" FontSize="13" Padding="21,9"/>
        <TextBlock Text="PNG · JPG · WebP · AVIF · GIF · TIFF · ICO" FontSize="12" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,18,0,0"/>
      </StackPanel>
      <Border x:Name="InfoPanel" Visibility="Collapsed" Width="310" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{DynamicResource BarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="7" Padding="17" Margin="16">
        <StackPanel><TextBlock x:Name="InfoTitle" FontSize="15" FontWeight="SemiBold"/><TextBox x:Name="InfoText" Margin="0,13,0,0" TextWrapping="Wrap" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextBrush}" FontSize="13"/></StackPanel>
      </Border>
      <Border x:Name="Toast" Visibility="Collapsed" Background="{DynamicResource BarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="14,9" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="20,20,20,18" MaxWidth="700">
        <TextBlock x:Name="ToastText" TextWrapping="Wrap" FontSize="13"/>
      </Border>
    </Grid>
    <Border x:Name="Filmstrip" Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource BarBrush}">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="Thumbnails" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,4"/></ScrollViewer>
      </Grid>
    </Border>
    <Border x:Name="StatusBar" Grid.Row="3" Background="{DynamicResource BarBrush}">
      <Grid Margin="14,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="FileLabel" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
        <TextBlock x:Name="DetailsLabel" Grid.Column="1" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="16,0,0,0"/>
        <Button x:Name="FilmstripToggleButton" Grid.Column="2" Click="FilmstripClick" Padding="7,2" Margin="10,0,0,0" FontSize="12" ToolTip="Show or hide thumbnails">
          <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,6,0"/><TextBlock x:Name="FilmstripLabel" Text="Thumbnails"/><TextBlock x:Name="FilmstripChevron" Text="&#xE70E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="7,0,0,0"/></StackPanel>
        </Button>
      </Grid>
    </Border>
  </Grid>
</Window>
